# Main/deployment environment reference. Keep real values in Vercel Environment
# Variables; never commit a populated .env file.
DATABASE_URL=

# Set both URLs to the canonical production origin in Vercel.
BETTER_AUTH_URL=https://your-active-production-domain.example
NEXT_PUBLIC_APP_URL=https://your-active-production-domain.example
NEXT_PUBLIC_APP_BASE_URL=https://your-active-production-domain.example
BETTER_AUTH_SECRET=

# Register this production callback in the production GitHub OAuth app:
# https://your-active-production-domain.example/api/auth/callback/github
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_WEBHOOK_SECRET=
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_APP_SLUG=

GOOGLE_GENERATIVE_AI_API_KEY=
DEPLOY_API_KEY=
DEPLOY_MODEL=deepseek-ai/deepseek-v4.1-flash-1017
GLM_API_KEY=
GLM_MODEL=glm-4.7-flash
OPENAI_API_KEY=
OPENAI_TEXT_MODEL=gpt-6-luna
OPENAI_ISSUE_AGENT_ID=

PINECONE_API_KEY=
PINECONE_GOOGLE_INDEX=repopilot-v2
PINECONE_NAMESPACE=
PINECONE_EMBEDDING_FIELD=embedding
AST_SERVICE_URL=

# 14900 paise is INR 149.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
NEXT_PUBLIC_RAZORPAY_KEY_ID=
RAZORPAY_PRO_AMOUNT=14900
RAZORPAY_CURRENCY=INR

RESEND_API_KEY=
EMAIL_FROM=RepoPilot Team <reports@repopilot.team>
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

FREE_MONTHLY_REVIEW_LIMIT=10
FREE_MONTHLY_CHAT_LIMIT=30
FREE_MONTHLY_TOOLKIT_LIMIT=20
